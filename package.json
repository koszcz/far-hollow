{
  "name": "far-hollow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm check:assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && depcruise src",
    "test": "vitest run",
    "check:assets": "tsx scripts/check-assets.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "miniplex": "^2.0.0",
    "preact": "^11.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
